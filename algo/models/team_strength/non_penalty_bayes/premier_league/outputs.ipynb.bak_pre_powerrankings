    "# ── Best-guess season simulation: same fixtures/results, ratings fixed at their\n",
    "# posterior mean instead of redrawn per simulation ──────────────────────────────\n",
    "_hxg_fixed = np.exp(baseline_mean + home_adv_mean + att_mean[_hri] + def_mean[_ari]) + BASELINE_HOME_PENS * _pen_mult_arr[_hri]\n",
    "_axg_fixed = np.exp(baseline_mean + att_mean[_ari] + def_mean[_hri]) + BASELINE_AWAY_PENS * _pen_mult_arr[_ari]\n",
    "\n",
    "_acc_bg = {k: np.zeros(n_t) for k in ['pts','pts_sq','w','d','l','gf','ga','xgf','xga','pos']}\n",
    "_cnt_bg = {k: np.zeros(n_t, dtype=np.int32) for k in ['title','top5','top8','rel']}\n",
    "_pos_freq_bg = np.zeros((n_t, n_t), dtype=np.int32)\n",
    "\n",
    "print(f\"Running {N_SIMS:,} best-guess simulations (fixed ratings)...\")\n",
    "for _s in range(N_SIMS):\n",
    "    if _s % 2000 == 0 and _s > 0:\n",
    "        print(f\"  {_s:,} / {N_SIMS:,}\")\n",
    "\n",
    "    _tbl = {t: {'played':0,'w':0,'d':0,'l':0,'gf':0,'ga':0,'xgf':0.,'xga':0.,'pts':0}\n",
    "            for t in teams}\n",
    "    for _ht, _at, _hg, _ag in _actual_res:\n",
    "        _update_table(_tbl, _ht, _at, _hg, _ag, 0., 0.)\n",
    "\n",
    "    _hgs = np.random.poisson(_hxg_fixed)\n",
    "    _ags = np.random.poisson(_axg_fixed)\n",
    "    for _j, (_ht, _at) in enumerate(_remaining):\n",
    "        _update_table(_tbl, _ht, _at, int(_hgs[_j]), int(_ags[_j]),\n",
    "                      float(_hxg_fixed[_j]), float(_axg_fixed[_j]))\n",
    "\n",
    "    _pts = np.array([_tbl[t]['pts'] for t in teams])\n",
    "    _gd  = np.array([_tbl[t]['gf'] - _tbl[t]['ga'] for t in teams])\n",
    "    _gf  = np.array([_tbl[t]['gf'] for t in teams])\n",
    "    _ord = np.lexsort((_gf, _gd, _pts))[::-1]\n",
    "    _pos = np.empty(n_t, dtype=np.int32)\n",
    "    _pos[_ord] = np.arange(1, n_t + 1)\n",
    "\n",
    "    _acc_bg['pts']    += _pts\n",
    "    _acc_bg['pts_sq'] += _pts ** 2\n",
    "    _acc_bg['w']      += [_tbl[t]['w']   for t in teams]\n",
    "    _acc_bg['d']      += [_tbl[t]['d']   for t in teams]\n",
    "    _acc_bg['l']      += [_tbl[t]['l']   for t in teams]\n",
    "    _acc_bg['gf']     += [_tbl[t]['gf']  for t in teams]\n",
    "    _acc_bg['ga']     += [_tbl[t]['ga']  for t in teams]\n",
    "    _acc_bg['xgf']    += [_tbl[t]['xgf'] for t in teams]\n",
    "    _acc_bg['xga']    += [_tbl[t]['xga'] for t in teams]\n",
    "    _acc_bg['pos']    += _pos\n",
    "    _cnt_bg['title']  += (_pos == 1)\n",
    "    _cnt_bg['top5']   += (_pos <= 5)\n",
    "    _cnt_bg['top8']   += (_pos <= 8)\n",
    "    _cnt_bg['rel']    += (_pos >= 18)\n",
    "    _pos_freq_bg[np.arange(n_t), _pos - 1] += 1\n",
    "\n",
    "_std_bg = np.sqrt(np.maximum(_acc_bg['pts_sq'] / N_SIMS - (_acc_bg['pts'] / N_SIMS) ** 2, 0))\n",
    "\n",
    "avg_table_bestguess = pd.DataFrame({\n",
    "    'team':              teams,\n",
    "    'avg_points':        _acc_bg['pts']  / N_SIMS,\n",
    "    'pts_low':           _acc_bg['pts']  / N_SIMS - 1.28 * _std_bg,\n",
    "    'pts_high':          _acc_bg['pts']  / N_SIMS + 1.28 * _std_bg,\n",
    "    'avg_wins':          _acc_bg['w']    / N_SIMS,\n",
    "    'avg_draws':         _acc_bg['d']    / N_SIMS,\n",
    "    'avg_losses':        _acc_bg['l']    / N_SIMS,\n",
    "    'avg_goals_for':     _acc_bg['gf']   / N_SIMS,\n",
    "    'avg_goals_against': _acc_bg['ga']   / N_SIMS,\n",
    "    'avg_xg_for':        _acc_bg['xgf']  / N_SIMS,\n",
    "    'avg_xg_against':    _acc_bg['xga']  / N_SIMS,\n",
    "    'avg_position':      _acc_bg['pos']  / N_SIMS,\n",
    "    'title_pct':         np.round(_cnt_bg['title'] / N_SIMS * 100, 1),\n",
    "    'top5_pct':          np.round(_cnt_bg['top5']  / N_SIMS * 100, 1),\n",
    "    'top8_pct':          np.round(_cnt_bg['top8']  / N_SIMS * 100, 1),\n",
    "    'relegation_pct':    np.round(_cnt_bg['rel']   / N_SIMS * 100, 1),\n",
    "})\n",
    "avg_table_bestguess['avg_goal_difference'] = avg_table_bestguess['avg_goals_for'] - avg_table_bestguess['avg_goals_against']\n",
    "avg_table_bestguess['avg_xg_difference']   = avg_table_bestguess['avg_xg_for']    - avg_table_bestguess['avg_xg_against']\n",
    "avg_table_bestguess = avg_table_bestguess.sort_values(\n",
    "    ['avg_points', 'avg_goal_difference', 'avg_goals_for'], ascending=False\n",
    ").reset_index(drop=True)\n",
    "avg_table_bestguess.index += 1\n",
    "\n",
    "position_freq_bestguess = {t: list(_pos_freq_bg[i]) for i, t in enumerate(teams)}\n",
    "avg_table_bestguess"
   ]
