    "from manual_priors_2026_27 import scaled_priors, sigma_ramp_scale, scaled_global_priors\n",
    "\n",
    "# Ramp sigma from ~half the season-target value at GW1 up to the full target\n",
    "# by GW10 (empirically swept against 2025-26's actual final posterior --\n",
    "# applying the season-target sigma from kickoff let one early extreme\n",
    "# scoreline swing a rating almost as much as it would mid-season).\n",
    "_games_played = len(_gw_ends)\n",
    "_sigma_scale = sigma_ramp_scale(_games_played)\n",
    "print(f\"Games played so far: {_games_played}  ->  sigma ramp scale: {_sigma_scale:.2f}\"\n",
    "      f\"{' (full season-target sigma)' if _sigma_scale >= 1.0 else ' (tightened for early season)'}\")\n",
    "_att_priors, _def_priors = scaled_priors(_games_played)\n",
    "# home_adv/baseline get the same ramp: load_and_process_data scopes to this season only, so\n",
    "# a handful of gameweeks is a genuinely small match sample for these two global parameters\n",
    "# too, not just for team-level att/def -- they previously had a fixed sigma with no ramp.\n",
    "_home_adv_prior, _baseline_prior = scaled_global_priors(_games_played)\n",
    "\n",
    "_, trace = build_and_sample_model(\n",
    "    df, n_teams, trace=N_SAMPLES, tune=N_TUNE,\n",
    "    team_mapping=team_mapping,\n",
    "    manual_att_priors=_att_priors,\n",
    "    manual_def_priors=_def_priors,\n",
    "    home_adv_prior=_home_adv_prior,\n",
    "    baseline_prior=_baseline_prior,\n",
    ")\n",
    "print('Done.')"
   ]
