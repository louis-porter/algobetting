    "# (this fit's own att/def posterior, not a stale season-old snapshot -- that distinction\n",
    "# matters, see the same notebook's season-ahead-forecast section for why) rather than\n",
    "# giving every team the identical flat number.\n",
    "PEN_MULTIPLIERS = compute_penalty_multipliers(team_mapping, att, defn, base, hadv)\n",
    "pd.Series(PEN_MULTIPLIERS, name='pen_multiplier').sort_values(ascending=False)"
   ]
