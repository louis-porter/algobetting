    "# ── Fetch all remaining PL fixtures from FotMob ───────────────────────────────\n",
    "import requests\n",
    "from scipy.stats import poisson\n",
    "from datetime import date as _date_cls\n",
    "\n",
    "sys.path.insert(0, os.path.join(REPO_ROOT, 'infra', 'data', 'collectors'))\n",
    "from fotmob.fotmob_season_downloader import LEAGUES as _FOTMOB_LEAGUES, HEADERS as _FOTMOB_HEADERS\n",
    "from fotmob.assign_gameweeks import assign_gameweeks\n",
    "\n",
    "_FOTMOB_LEAGUE_ID = next(l['id'] for l in _FOTMOB_LEAGUES if l['name'] == LEAGUE)\n",
    "_SEASON_SLASH = SEASON.replace('-', '/')  # '2026-2027' -> '2026/2027'\n",
    "\n",
    "def _get_all_remaining_fixtures():\n",
    "    \"\"\"Fetch every unplayed fixture for the season from FotMob's own fixtures list.\n",
    "\n",
    "    Replaces the old TheSportsDB-based fetch: TheSportsDB's free/demo key only\n",
    "    lists roughly half the fixtures per round (verified live — rounds 1, 2 and 3\n",
    "    each returned exactly 5 of ~10 matches), which silently truncated \"next\n",
    "    gameweek\" to whichever handful of fixtures happened to be populated —\n",
    "    e.g. showing only Saturday's games from a Friday-Monday gameweek.\n",
    "    FotMob's /fixtures endpoint returns the complete season (played + unplayed)\n",
    "    in one call, already in our own team-naming convention (no translation\n",
    "    dict needed). GW numbers are computed with the same calendar-window logic\n",
    "    (assign_gameweeks) used to write custom_gw into the DB, over the *full*\n",
    "    season's fixture list — so numbering lines up with what's already stored,\n",
    "    rather than restarting from 1 for whatever was fetched.\n",
    "    \"\"\"\n",
    "    r = requests.get(\n",
    "        'https://www.fotmob.com/api/data/fixtures',\n",
    "        params={'id': _FOTMOB_LEAGUE_ID, 'season': _SEASON_SLASH},\n",
    "        headers=_FOTMOB_HEADERS, timeout=20,\n",
    "    )\n",
    "    r.raise_for_status()\n",
    "    all_fx = r.json()\n",
    "\n",
    "    fx_df = pd.DataFrame([{\n",
    "        'match_date': f['status']['utcTime'],\n",
    "        'home':       f['home']['name'],\n",
    "        'away':       f['away']['name'],\n",
    "        'finished':   f['status']['finished'],\n",
    "    } for f in all_fx])\n",
    "    local = pd.to_datetime(fx_df['match_date'], utc=True, format='ISO8601').dt.tz_convert('Europe/London')\n",
    "    fx_df['date'] = local.dt.strftime('%Y-%m-%d')\n",
    "    fx_df['time'] = local.dt.strftime('%H:%M')\n",
    "    fx_df['match_date'] = fx_df['date']  # assign_gameweeks expects this column name\n",
    "    fx_df = assign_gameweeks(fx_df).rename(columns={'custom_gw': 'gw'})\n",
    "\n",
    "    unplayed = fx_df[~fx_df['finished']]\n",
    "    return (unplayed[['gw', 'date', 'time', 'home', 'away']]\n",
    "            .sort_values(['date', 'time']).to_dict('records'))\n",
    "\n",
    "def _predict(home_team, away_team):\n",
    "    \"\"\"Return (home_lam, away_lam) including penalty baseline, scaled by each team's own\n",
    "    relative quality (PEN_MULTIPLIERS). Point-estimate (posterior-mean) computation --\n",
    "    same att_mean/def_mean/baseline_mean/home_adv_mean as ratings_df above, not the full\n",
    "    posterior-predictive mean -- so these GW predictions are directly consistent with the\n",
    "    ratings table rather than inflated by how uncertain the model still is about a team's\n",
    "    rating. NOTE: this also feeds the Asian handicap pricing below (and the standalone\n",
    "    example) via next_gw_df's Home xG/Away xG columns -- pricing a market off a point\n",
    "    estimate understates real forecast uncertainty, which is a different, arguably more\n",
    "    consequential tradeoff than for a display number. Give that its own full-uncertainty\n",
    "    computation if/when that distinction matters here.\"\"\"\n",
    "    hi = team_mapping[home_team]\n",
    "    ai = team_mapping[away_team]\n",
    "    home_lam = np.exp(baseline_mean + home_adv_mean + att_mean[hi] + def_mean[ai]) + BASELINE_HOME_PENS * PEN_MULTIPLIERS[home_team]\n",
    "    away_lam = np.exp(baseline_mean + att_mean[ai] + def_mean[hi]) + BASELINE_AWAY_PENS * PEN_MULTIPLIERS[away_team]\n",
    "    return home_lam, away_lam\n",
    "\n",
    "def _match_probs(home_lam, away_lam, max_goals=10):\n",
    "    \"\"\"Win / Draw / Loss probabilities via Poisson convolution.\"\"\"\n",
    "    h = np.array([poisson.pmf(g, home_lam) for g in range(max_goals + 1)])\n",
    "    a = np.array([poisson.pmf(g, away_lam) for g in range(max_goals + 1)])\n",
    "    grid = np.outer(h, a)\n",
    "    win  = float(np.tril(grid, -1).sum())\n",
    "    draw = float(np.trace(grid))\n",
    "    loss = float(np.triu(grid,  1).sum())\n",
    "    return win, draw, loss\n",
    "\n",
    "# ── Build predictions for all remaining fixtures ──────────────────────────────\n",
    "_today_str = str(_date_cls.today() + timedelta(days=2))\n",
    "fixtures = _get_all_remaining_fixtures()\n",
    "print(f\"Fetched {len(fixtures)} remaining fixtures\")\n",
    "\n",
    "rows = []\n",
    "for f in fixtures:\n",
    "    if f['home'] not in team_mapping or f['away'] not in team_mapping:\n",
    "        print(f\"Warning: unknown team(s) — {f['home']} / {f['away']}\")\n",
    "        continue\n",
    "    hl, al = _predict(f['home'], f['away'])\n",
    "    w, d, l = _match_probs(hl, al)\n",
    "    rows.append({\n",
    "        'GW':      f['gw'],\n",
    "        'Date':    f['date'],\n",
    "        'Time':    f['time'],\n",
    "        'Home':    f['home'],\n",
    "        'Away':    f['away'],\n",
    "        'Home xG': round(hl, 2),\n",
    "        'Away xG': round(al, 2),\n",
    "        'Home W%': round(w * 100, 1),\n",
    "        'Draw%':   round(d * 100, 1),\n",
    "        'Away W%': round(l * 100, 1),\n",
    "    })\n",
    "\n",
    "_PRED_COLS = ['GW','Date','Time','Home','Away','Home xG','Away xG','Home W%','Draw%','Away W%']\n",
    "pred_df = pd.DataFrame(rows, columns=_PRED_COLS) if rows else pd.DataFrame(columns=_PRED_COLS)\n",
    "if pred_df.empty:\n",
    "    print(\"Warning: no upcoming fixtures fetched — check FotMob's fixtures API.\")\n",
    "# Skip any part-played GW (< 5 remaining matches) and show the next full one\n",
    "_gw_counts = pred_df.groupby(\"GW\").size()\n",
    "_next_gw = _gw_counts[_gw_counts >= 2].index.min()\n",
    "next_gw_df = pred_df[pred_df[\"GW\"] == _next_gw].reset_index(drop=True)\n",
    "next_gw_df"
   ]
  },
