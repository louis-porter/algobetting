    "    'ga':   [ga_d[t]  for t in _teams],\n",
    "    'gd':   [gf_d[t] - ga_d[t] for t in _teams],\n",
    "}).sort_values(['pts', 'gd', 'gf'], ascending=False).reset_index(drop=True)\n",
