    "# ── ratings_df: Bayesian avg-vs-all-opponents, point-estimate (posterior means) ──\n",
    "# Previously exp()'d every posterior draw then averaged -- E[exp(X)], the full posterior-\n",
    "# predictive mean. That's the mathematically complete quantity when you need genuine\n",
    "# forecast uncertainty (e.g. the season-simulation loop below, which should keep doing this\n",
    "# -- real parameter uncertainty should show up as real spread in simulated final standings).\n",
    "# But for a \"what does this team's current level look like\" rating table, it's the wrong\n",
    "# tool: since exp() is convex, E[exp(X)] > exp(E[X]) whenever X has any spread (Jensen's\n",
    "# inequality) -- so this was inflating every team's number by how UNCERTAIN we are about\n",
    "# their rating, not by how good they actually are. Checked empirically: at the current\n",
    "# ramp stage this added ~0.11 goals on top of the point estimate (2.97 vs 2.86 mean\n",
    "# total_xg) purely from that effect, on top of a smaller residual gap in the prior means\n",
    "# themselves vs last season's actual 2.75 average. Using exp(E[X]) here instead removes the\n",
    "# uncertainty-inflation piece and matches what \"current rating\" intuitively means.\n",
    "baseline_mean = trace.posterior[\"baseline\"].values.mean()\n",
    "home_adv_mean = trace.posterior[\"home_adv\"].values.mean()\n",
    "att_mean      = trace.posterior[\"att_str\"].values.reshape(-1, n_teams).mean(axis=0)\n",
    "def_mean      = trace.posterior[\"def_str\"].values.reshape(-1, n_teams).mean(axis=0)\n",
    "all_teams_list = list(team_mapping.keys())\n",
    "\n",
    "team_stats = {t: {\"goals_for\": 0, \"goals_against\": 0, \"matches\": 0} for t in all_teams_list}\n",
    "\n",
    "for home_team in all_teams_list:\n",
    "    hi = team_mapping[home_team]\n",
    "    for away_team in all_teams_list:\n",
    "        if home_team == away_team:\n",
    "            continue\n",
    "        ai = team_mapping[away_team]\n",
    "        home_lam = np.exp(baseline_mean + home_adv_mean + att_mean[hi] + def_mean[ai])\n",
    "        away_lam = np.exp(baseline_mean + att_mean[ai] + def_mean[hi])\n",
    "\n",
    "        hg = home_lam + BASELINE_HOME_PENS * PEN_MULTIPLIERS[home_team]\n",
    "        ag = away_lam + BASELINE_AWAY_PENS * PEN_MULTIPLIERS[away_team]\n",
    "\n",
    "        team_stats[home_team][\"goals_for\"]     += hg\n",
    "        team_stats[home_team][\"goals_against\"] += ag\n",
    "        team_stats[home_team][\"matches\"]       += 1\n",
    "        team_stats[away_team][\"goals_for\"]     += ag\n",
    "        team_stats[away_team][\"goals_against\"] += hg\n",
    "        team_stats[away_team][\"matches\"]       += 1\n",
    "\n",
    "ratings_df = pd.DataFrame([{\n",
    "    \"team\":          t,\n",
    "    \"goals_for\":     team_stats[t][\"goals_for\"]     / team_stats[t][\"matches\"],\n",
    "    \"goals_against\": team_stats[t][\"goals_against\"] / team_stats[t][\"matches\"],\n",
    "    \"goal_diff\":     (team_stats[t][\"goals_for\"] - team_stats[t][\"goals_against\"]) / team_stats[t][\"matches\"],\n",
    "    \"total_xg\":      (team_stats[t][\"goals_for\"] + team_stats[t][\"goals_against\"]) / team_stats[t][\"matches\"],\n",
    "} for t in all_teams_list]).sort_values(\"goal_diff\", ascending=False).reset_index(drop=True)\n",
    "\n",
    "print(ratings_df.to_string(index=False))\n",
    "\n",
    "print('Totals')\n",
    "print(f'Home goals: {ratings_df['goals_for'].sum():.2f}')\n",
    "print(f'Away goals: {ratings_df['goals_against'].sum():.2f}')"
   ]
