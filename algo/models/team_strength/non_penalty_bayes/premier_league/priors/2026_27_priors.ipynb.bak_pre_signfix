    "def _fmt_dict(raw: dict, sigma_map: dict) -> str:\n",
    "    lines = []\n",
    "    for t in RETURNING:\n",
    "        lines.append(f\"    {t!r:>18}: ({raw[t]:.3f}, {sigma_map[t]}),\")\n",
